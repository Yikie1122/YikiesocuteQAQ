<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>媽媽生日快樂！</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  font-family: "Microsoft JhengHei", sans-serif;
  background: linear-gradient(135deg,#ffe4ec,#fff2dc);
  color: #884c60;
  text-align: center;
  overflow-x: hidden;
}
main { padding: 45px 15px; }
h1 { font-size: 38px; }
p { font-size: 18px; }
.panel {
  max-width: 600px;
  margin: 25px auto;
  padding: 30px 20px;
  background: #ffffffd9;
  border-radius: 25px;
  box-shadow: 0 8px 25px #d69aaf55;
}
button {
  border: none;
  border-radius: 18px;
  padding: 15px 25px;
  margin: 10px;
  background: #ed91ac;
  color: white;
  font-size: 18px;
  cursor: pointer;
}
button:hover { transform: scale(1.07); }
.gifts {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 15px;
}
.gift {
  font-size: 65px;
  cursor: pointer;
  background: #fff0f4;
  padding: 15px;
  border-radius: 20px;
}
#message {
  font-size: 22px;
  min-height: 65px;
  color: #d46d91;
}
#final { display: none; }
#cake { font-size: 100px; }
#confetti {
  position: fixed;
  inset: 0;
  pointer-events: none;
  font-size: 25px;
}
</style>
</head>
<body>
<main>
  <h1>🎀 母親生日快樂！ 🎀</h1>
  <p>11月2日，是特別日子。</p>

  <section class="panel" id="start">
    <div style="font-size:90px">🎂</div>
    <h2>生日驚喜</h2>
    <p>有一份神秘禮物！</p>
    <p>準備好接受生日驚喜了嗎？</p>
    <button onclick="begin()">開始遊戲 ♡</button>
  </section>

  <section class="panel" id="game" style="display:none">
    <h2>🎁 第一關：拆開生日禮物</h2>
    <p>請點開下面三個禮物盒！</p>
    <div class="gifts">
      <div class="gift" onclick="openGift(0)">🎁</div>
      <div class="gift" onclick="openGift(1)">🎁</div>
      <div class="gift" onclick="openGift(2)">🎁</div>
    </div>
    <p id="message">還有 3 個禮物等待拆開！</p>
  </section>

  <section class="panel" id="final">
    <h2>🎂 最後一關：生日許願！</h2>
    <div id="cake">🕯️🎂🕯️</div>
    <p>閉上眼睛，許下一個願望吧！</p>
    <button onclick="wish()">吹熄蠟燭！</button>
    <div id="ending" style="display:none">
      <h1>🎉 生日快樂！！！</h1>
      <h2>親愛的母親 ❤️</h2>
      <p>
        感謝一直以來的照顧與付出。<br>
        祝妳每天都能健康、平安、快樂。<br>
        <strong>生日快樂！</strong>
      </p>
      <div style="font-size:55px">💗🌷🎂🌷💗</div>
    </div>
  </section>
</main>
<div id="confetti"></div>

<script>
let opened = [false,false,false];
let words = [
  "💗 第一份禮物：祝妳每天都開開心心！",
  "🌷 第二份禮物：祝妳永遠健康平安！",
  "✨ 第三份禮物：祝妳所有願望都能實現！"
];

function begin() {
  document.getElementById("start").style.display="none";
  document.getElementById("game").style.display="block";
}

function openGift(i) {
  if(opened[i]) return;
  opened[i]=true;
  document.querySelectorAll(".gift")[i].innerHTML="💝";
  document.getElementById("message").innerText=words[i];
  if(opened.every(Boolean)) {
    document.getElementById("message").innerText=
      "恭喜完成所有任務！準備迎接最後的驚喜！";
    setTimeout(()=>{
      document.getElementById("game").style.display="none";
      document.getElementById("final").style.display="block";
    },1500);
  }
}

function wish() {
  document.getElementById("cake").innerHTML="🎂";
  document.getElementById("ending").style.display="block";
  document.getElementById("confetti").innerHTML=
    "🎉✨🎊💗🌸🎉✨🎊💗🌸";
}
</script>
</body>
</html>
